#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ht_sft: hold_tap_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&sk>, <&kp>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        td_bracket: td_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
        };

        esc_tilde: esc_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_TILDE";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ht_sk: ht_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SK";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&sk>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ralt {
            bindings = <&kp RALT>;
            key-positions = <27 26>;
            timeout-ms = <50>;
            layers = <0>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <14 15>;
            layers = <0>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <37 38>;
            layers = <0>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <38 39>;
            layers = <0>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <39 40>;
            layers = <0>;
        };

        leftbootloader {
            bindings = <&bootloader>;
            key-positions = <0 41>;
            layers = <0>;
        };

        rightbootloader {
            bindings = <&bootloader>;
            key-positions = <42 11>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------
            // |ESC | 1  | 2  | 3  | 4  | 5  |   | 6  | 7  | 8  | 9  | 0  |DEL |
            // |TAB | Q  | W  | E  | R  | T  |   | Y  | U  | I  | O  | P  |HOME|
            // |CAPS| A  | S  | D  | F  | G  |   | H  | J  | K  | L  | ;  |PGUP|
            // |LSFT| Z  | X  | C  | V  | B  |   | N  | M  | ,  | .  | /  |PGDN|
            // |LCTL|LALT|LGUI|                                 |RALT|RCTL|END |
            //                |MO1 |LANG|SPC |   |BSPC|RET |MO1 | B  |

            bindings = <
&esc_tilde           &as EXCL N1           &as AT N2         &as HASH N3  &as DLLR N4  &as PRCNT N5  &as CARET N6  &as AMPS N7  &as STAR N8  &as LPAR N9  &as RPAR N0  &td_bracket
&kp TAB              &kp Q                 &kp W             &kp E        &kp R        &kp T         &kp Y         &kp U        &kp I        &kp O        &kp P        &kp BACKSPACE
&lt 1 SPACE          &kp A                 &kp S             &kp D        &kp F        &kp G         &kp H         &kp J        &kp K        &kp L        &kp SEMI     &lt 1 ENTER
&ht_sft LSHFT SPACE  &kp Z                 &kp X             &kp C        &kp V        &kp B         &kp N         &kp M        &kp COMMA    &kp DOT      &kp FSLH     &ht_sft RSHIFT SQT
&kp LCTRL            &kp LALT              &ht_sk LGUI LGUI  &none        &none        &none         &none         &none        &none        &kp RALT     &kp RCTRL    &kp DEL
&kp LANG1            &ht_sft LSHIFT SPACE  &lt 1 SPACE                                               &lt 2 ENTER   &kp DEL      &mo 2        &kp B
            >;
        };

        lower_layer {
            bindings = <
&kp F1       &kp F2    &kp F3    &kp F4    &kp F5     &kp F6     &kp F7          &kp F8     &kp F9     &kp F10    &kp F11          &kp F12
&kp INS      &kp INS   &kp HOME  &kp UP    &kp END    &kp PG_UP  &kp KP_NUMLOCK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS      &kp DEL
&trans       &kp LEFT  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &mkp RCLK       &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS     &kp EQUAL
&trans       &trans    &trans    &trans    &trans     &trans     &mkp LCLK       &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MULTIPLY  &kp KP_DOT
&trans       &trans    &trans    &trans    &trans     &trans     &trans          &trans     &trans     &kp KP_N0  &kp KP_DIVIDE    &kp KP_ENTER
&bootloader  &trans    &trans                                    &trans          &trans     &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&kp PRINTSCREEN  &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans
&trans           &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans
&trans           &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans
&trans           &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans
&bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &bootloader
&bootloader      &trans        &trans                                &trans  &trans  &bootloader  &trans
            >;
        };
    };
};
